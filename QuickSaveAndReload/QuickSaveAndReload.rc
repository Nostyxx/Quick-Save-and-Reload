#include <winver.h>

#include "include/version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION QSR_VERSION_MAJOR, QSR_VERSION_MINOR, QSR_VERSION_PATCH, 0
 PRODUCTVERSION QSR_VERSION_MAJOR, QSR_VERSION_MINOR, QSR_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Nosty"
            VALUE "FileDescription", "Quick save and quick load mod for Crimson Desert"
            VALUE "FileVersion", QSR_VERSION_STRING
            VALUE "InternalName", "QuickSaveAndReload"
            VALUE "LegalCopyright", "Copyright (C) 2026 Nosty"
            VALUE "OriginalFilename", "QuickSaveAndReload.asi"
            VALUE "ProductName", "Quick Save and Reload"
            VALUE "ProductVersion", QSR_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
